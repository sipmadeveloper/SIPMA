{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "includeFiles": "data/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__vercel_route=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vercel_route=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__vercel_route=/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
